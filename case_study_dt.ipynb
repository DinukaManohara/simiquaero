    "pdf = make_pdf(COMPONENTS)\n",
    "p = target_props(COMPONENTS, centers)          # target proportion per bin\n",
    "if p is None:\n",
    "    raise ValueError(\"the mixture puts no mass on the target's range -- adjust COMPONENTS\")\n",
    "target = {b: float(p[b]) for b in range(n_bins)}\n",
    "\n",
    "xs = np.linspace(tmin, tmax, 400)\n",
    "ys = np.array([pdf(x) for x in xs])\n",
    "fig, ax = plt.subplots(figsize=(fig_width, fig_height))\n",
    "ax.plot(xs, ys, color=CB_palette[\"CBdarkblue\"])\n",
    "ax.fill_between(xs, ys, color=CB_palette[\"CBblue\"], alpha=0.2)\n",
    "ax.set_xlabel(TARGET); ax.set_yticks([])\n",
    "fig.tight_layout(pad=0.3)\n",
    "plt.show()\n",
    "\n",
    "ok, max_pct, b, need, have = feasibility(p, avail, N, CARDINALITY_PCT)\n",
    "if ok:\n",
    "    print(f\"feasible at {CARDINALITY_PCT}%   (max ~ {max_pct:.0f}% of rows)\")\n",
    "else:\n",
    "    print(f\"INFEASIBLE at {CARDINALITY_PCT}%: bin {b} needs {need:.0f} rows but has {have}\"\n",
