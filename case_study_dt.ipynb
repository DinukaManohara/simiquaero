    "### Plot + report helpers\n",
    "\n",
    "`show(result, label)` draws what the UI's bottom panel draws (full-data histogram,\n",
    "the subset's histogram and the specified pdf), then prints the metrics and the rule.\n",
    "Pass `save=\"figures/name.pdf\"` to also write the figure."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "cs13",
   "metadata": {},
   "outputs": [],
   "source": [
    "def metrics_of(res):\n",
    "    return dist_metrics(res[\"got\"], res[\"tc\"])\n",
    "\n",
    "def show(res, label, max_terms=20, save=None):\n",
    "    rows = res[\"rows\"]\n",
    "    sel = df[TARGET].to_numpy()[rows]\n",
    "    m = metrics_of(res)\n",
    "    simple = res[\"simple\"]\n",
    "    fig, ax = plt.subplots(figsize=(fig_width, fig_height))\n",
    "    ax.hist(df[TARGET], bins=edges, density=True, alpha=0.35,\n",
    "            color=CB_palette[\"CBblue\"], label=\"full\")\n",
    "    if len(sel):\n",
    "        ax.hist(sel, bins=edges, density=True, alpha=0.75,\n",
    "                color=CB_palette[\"CBred\"], label=\"subset\")\n",
    "    ax.plot(xs, ys, \"--\", color=CB_palette[\"CBdarkgrey\"], label=\"target pdf\")\n",
    "    ax.set_xlabel(TARGET); ax.set_yticks([]); ax.legend(frameon=False)\n",
    "    fig.tight_layout(pad=0.3)\n",
    "    if save:\n",
    "        Path(save).parent.mkdir(parents=True, exist_ok=True)\n",
    "        fig.savefig(save, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "    print(f\"{label}: rows {len(sel)} / {N}   terms {simple['n_terms']} \"\n",
    "          f\"(tree: {res['red']['n_terms']})   literals {simple['n_literals']}   \" +\n",
    "          \"   \".join(f\"{k.upper()}={v}\" for k, v in m.items()))\n",
    "    print(rule_to_str(simple, max_terms=max_terms))\n",
    "    # res[\"simple\"][\"expr\"] holds the same rule as a sympy expression\n",
    "\n",
    "def table(results, labels):\n",
    "    return pd.DataFrame([dict(result=l, rows=len(r[\"rows\"]), terms=r[\"simple\"][\"n_terms\"],\n",
    "                              literals=r[\"simple\"][\"n_literals\"],\n",
    "                              tree_terms=r[\"red\"][\"n_terms\"], **metrics_of(r))\n",
    "                         for r, l in zip(results, labels)])"
   ]
  },
