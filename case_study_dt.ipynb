    "if DATASET_PATH is None or not Path(DATASET_PATH).exists():\n",
    "    if DATASET_PATH is not None:\n",
    "        print(f\"!! {DATASET_PATH} not found -- falling back to the SYNTHETIC dataset !!\")\n",
    "    df, TARGET = default_dataset()\n",
    "    raw, meta, name = df.copy(), {}, \"synthetic (default)\"\n",
    "else:\n",
    "    raw, meta, name = read_dataset(DATASET_PATH)\n",
    "    cands = target_candidates(raw, meta)\n",
    "    if TARGET is None:\n",
    "        TARGET = cands[0]\n",
    "    if TARGET not in raw.columns:\n",
    "        raise ValueError(f\"TARGET {TARGET!r} not in columns {list(raw.columns)}\")\n",
    "    df = prepare_frame(raw, TARGET, meta)\n",
    "\n",
    "if MAX_ROWS is not None and len(df) > MAX_ROWS:\n",
    "    df = df.sample(MAX_ROWS, random_state=SEED).reset_index(drop=True)\n",
    "\n",
    "# what preprocessing did (mirrors prepare_frame's rules)\n",
    "dropped_ids    = [c for c in meta.get(\"id_variables\", []) if c in raw.columns]\n",
    "dropped_tgts   = [c for c in meta.get(\"target_variable\", []) if c in raw.columns and c != TARGET]\n",
    "encoded        = [c for c in raw.columns if c in df.columns\n",
    "                  and not pd.api.types.is_numeric_dtype(raw[c])]\n",
    "desc_cols      = [c for c in df.columns if c != TARGET]\n",
    "\n",
    "print(f\"dataset        : {name}   ({'metadata' if meta else 'no metadata, separator sniffed'})\")\n",
    "if meta:\n",
    "    print(f\"delimiter      : {meta.get('delim')!r}\")\n",
    "    print(f\"declared target: {meta.get('target_variable')}\")\n",
    "print(f\"target         : {TARGET}\")\n",
    "print(f\"raw shape      : {raw.shape}\")\n",
    "print(f\"dropped ids    : {dropped_ids or '-'}\")\n",
    "print(f\"dropped targets: {dropped_tgts or '-'}   (other declared targets, so they cannot leak)\")\n",
    "print(f\"encoded        : {encoded or '-'}   (non-numeric -> integer codes)\")\n",
    "print(f\"rows dropped   : {len(raw) - len(df) if MAX_ROWS is None else 'n/a (subsampled)'}   (NaN/inf)\")\n",
    "print(f\"final shape    : {df.shape}   -> {len(desc_cols)} descriptors\")\n",
