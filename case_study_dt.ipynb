   "source": [
    "from matplotlib.patches import Patch\n",
    "from matplotlib.lines import Line2D\n",
    "\n",
    "TERM_RANGE = range(1, 5)                 # K = 1..4 boxes\n",
    "THRESHOLD_RANGE = [0.125, 0.1, 0.075, 0.05]\n",
    "\n",
    "best_by_k, report = {}, []\n",
    "for k, tvd_thres in zip(TERM_RANGE, THRESHOLD_RANGE):\n",
    "    t0 = time.perf_counter()\n",
    "    ranked = rank_by_rule_length(find_multiple_box_subsets(ix, target, k, tvd_thres), by=RANK_BY)\n",
    "    print(f\"K={k}: {len(ranked)} subset(s) under TVD {tvd_thres} \"\n",
    "          f\"in {time.perf_counter() - t0:.1f}s\")\n",
    "    best_by_k[k] = ranked[0] if ranked else None\n",
    "    report.append(f\"=== K = {k} box(es) ===\")\n",
    "    if not ranked:\n",
    "        report += [f\"no subset with TVD <= {tvd_thres}\", \"\"]\n",
    "        continue\n",
    "    b, m = ranked[0], metrics_of(ranked[0])\n",
    "    report += [f\"subsets found: {len(ranked)}   best: rank 1 (sorted by {RANK_BY})\",\n",
    "               f\"rows: {len(b['rows'])} / {N}   terms: {b['simple']['n_terms']} \"\n",
    "               f\"(tree: {b['red']['n_terms']})   literals: {b['simple']['n_literals']}\",\n",
    "               \"   \".join(f\"{key.upper()}={v}\" for key, v in m.items()),\n",
    "               \"rule:\", rule_to_str(b[\"simple\"], max_terms=b[\"simple\"][\"n_terms\"]), \"\"]\n",
    "\n",
    "full = df[TARGET].to_numpy()\n",
    "c_full, c_sub, c_q = CB_palette[\"CBblue\"], CB_palette[\"CBred\"], CB_palette[\"CBdarkgrey\"]\n",
    "fig, axs = plt.subplots(1, len(TERM_RANGE), sharex=True, layout=\"constrained\",\n",
    "                        figsize=(text_width, text_width / len(TERM_RANGE) * ASPECT + 1.05))\n",
    "# + 1.05 in for the legend, panel titles, tick labels and x label, so the plot\n",
    "# areas keep roughly the design-language aspect\n",
    "for ax, k in zip(axs, TERM_RANGE):\n",
    "    ax.hist(full, bins=edges, density=True, alpha=0.35, color=c_full)\n",
    "    if best_by_k[k] is not None:\n",
    "        ax.hist(full[best_by_k[k][\"rows\"]], bins=edges, density=True, alpha=0.75, color=c_sub)\n",
    "    else:\n",
    "        ax.text(0.5, 0.5, \"none\", transform=ax.transAxes, ha=\"center\", va=\"center\")\n",
    "    ax.plot(xs, ys, \"--\", color=c_q)\n",
    "    ax.set_title(f\"{k} term\" + (\"s\" if k > 1 else \"\"))\n",
    "    ax.set_yticks([]); ax.locator_params(axis=\"x\", nbins=3)\n",
    "fig.supxlabel(TARGET)\n",
    "fig.legend(handles=[Patch(color=c_full, alpha=0.35, label=\"full\"),\n",
    "                    Patch(color=c_sub, alpha=0.75, label=\"best subset\"),\n",
    "                    Line2D([], [], color=c_q, linestyle=\"--\", label=\"query\")],\n",
    "           loc=\"outside upper center\", ncol=3, frameon=False)\n",
    "\n",
    "path = fig_path(dist_tag(COMPONENTS), f\"term_{TERM_RANGE[0]}to{TERM_RANGE[-1]}\")\n",
    "Path(path).parent.mkdir(parents=True, exist_ok=True)\n",
    "fig.savefig(path)                        # exactly 516 pt wide: no bbox_inches=\"tight\"\n",
    "txt = Path(path).with_suffix(\".txt\")\n",
    "txt.write_text(\"\\n\".join([f\"dataset: {name}   target: {TARGET}   N={N}\",\n",
    "                          f\"query: {COMPONENTS}\",\n",
    "                          f\"term-restricted query \"\n",
    "                          f\"ranked by {RANK_BY}\", \"\"] + report) + \"\\n\")\n",
    "print(f\"saved {path}\\nsaved {txt}\")\n",
    "plt.show()"
   ]
