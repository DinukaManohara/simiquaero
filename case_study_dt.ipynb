    "# PDF saving: FIG_DIR/{title}_{distribution}_{query}_{detail}.pdf (only when SAVE_PDF)\n",
    "def _num(v):\n",
    "    \"\"\"Number for a file name: 4 significant digits, no dots or minus signs\n",
    "    (dots break \\\\includegraphics): 0.15 -> 0p15, -1 -> m1, 1e+05 -> 1e05.\"\"\"\n",
    "    s = f\"{float(v):.4g}\"\n",
    "    return s.replace(\"-\", \"m\").replace(\".\", \"p\").replace(\"+\", \"\")\n",
    "\n",
    "def dist_tag(components):\n",
    "    \"\"\"The queried distribution, e.g. weibull-shape15-scale2183p6-loc10000-w1.\"\"\"\n",
    "    return \"+\".join(f\"{n}-\" + \"-\".join(f\"{k}{_num(v)}\" for k, v in params.items())\n",
    "                    + f\"-w{_num(w)}\" for n, params, w in components)\n",
    "\n",
    "def fig_path(*parts):\n",
    "    \"\"\"FIG_DIR/{title}_{parts...}.pdf, where title is TITLE or the dataset's name.\"\"\"\n",
    "    title = TITLE or name\n",
    "    return str(Path(FIG_DIR) / (\"_\".join([title, *map(str, parts)]) + \".pdf\"))\n",
    "\n",
    "def save_pdf(fig, path):\n",
    "    if SAVE_PDF:\n",
    "        Path(path).parent.mkdir(parents=True, exist_ok=True)\n",
    "        fig.savefig(path, bbox_inches=\"tight\", format='pdf')\n",
    "        print(f\"saved {path}\")"
   ]
  },
